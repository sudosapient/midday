# All values must belong to one hosted Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_INTERNAL_URL=https://PROJECT_REF.supabase.co
SUPABASE_AUTH_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
SUPABASE_SECRET_KEY=

# Start with the hosted project's session pooler URL for all three values.
DATABASE_PRIMARY_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
DATABASE_PRIMARY_POOLER_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
DATABASE_SESSION_POOLER=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres

# Generate these under Storage > S3 in the same hosted project.
R2_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=apps
